# =====================================================================
# AGENTIC CITYSCAPE - ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# Copy this file to .env and adjust variables as needed.
# =====================================================================

# ---------------------------------------------------------------------
# 1. NETWORK PORTS & HOST BINDING (STRICTLY LOCALHOST 127.0.0.1)
# ---------------------------------------------------------------------
DESKTOP_HOST=127.0.0.1
DESKTOP_APP_PORT=8765

# Local Model Runtimes
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

COLIBRI_HOST=127.0.0.1
COLIBRI_PORT=8080
COLIBRI_BASE_URL=http://127.0.0.1:8080/v1

FREELLMAPI_HOST=127.0.0.1
FREELLMAPI_PORT=8000
FREELLMAPI_BASE_URL=http://127.0.0.1:8000/v1

# ---------------------------------------------------------------------
# 2. MODEL SELECTION & TIER OVERRIDES
# ---------------------------------------------------------------------
# Tier 0 (Local Ollama) - Suggested: llama3.2:1b (8GB RAM) or llama3.2:3b (16GB RAM)
OLLAMA_MODEL=llama3.2:3b

# Tier 1 (Local Colibri MoE) - Suggested: colibri/glm-5.2-moe or colibri/mixtral-8x22b
COLIBRI_MODEL=colibri/glm-5.2-moe
COLIBRI_MAX_RAM_CACHE_GB=3.5

# Tier 2 (FreeLLMAPI Gateway) - 34 free providers / 635 endpoints
FREELLMAPI_MODEL=meta-llama/llama-3.3-70b-instruct

# Tier 3 (Paid Frontier) - Strictly gated for final executive audit
PAID_FRONTIER_MODEL=claude-3-5-sonnet

# ---------------------------------------------------------------------
# 3. SECURE API CREDENTIALS (OPTIONAL / STORED VIA DPAPI ON WINDOWS)
# ---------------------------------------------------------------------
# Paid Frontier API keys are strictly optional and only needed if Tier 3 is engaged.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FREELLMAPI_API_KEY=

# ---------------------------------------------------------------------
# 4. DELL INSPIRON 5410 HARDWARE PROFILING & THERMAL LIMITERS
# ---------------------------------------------------------------------
# Force hardware profile (AUTO / 8GB / 16GB)
HARDWARE_PROFILE=AUTO
FORCE_8GB_PROFILE=false

# Worker thread concurrency cap (Recommended: 4 for Tiger Lake 15W-28W TDP)
MAX_WORKER_THREADS=4

# Inactive model unload timer in minutes (Returns RAM back to Windows)
OLLAMA_KEEP_ALIVE=5m

# Battery-aware failover: when true, shifts heavy compute to FreeLLMAPI when unplugged
ENABLE_BATTERY_AWARE_ROUTING=true

# ---------------------------------------------------------------------
# 5. PERSISTENT STORAGE & LOGGING
# ---------------------------------------------------------------------
MEMORY_STORAGE_DIR=./persistent_memory
LOG_LEVEL=INFO
ENABLE_STRUCTURED_JSON_LOGS=true

# ---------------------------------------------------------------------
# INTERNET & AUTONOMOUS WEB RESEARCH PERMISSIONS
# ---------------------------------------------------------------------
ALLOW_INTERNET_RESEARCH=true
ENABLE_WEB_SEARCH=true
SSRF_PROTECTION_ENFORCED=true
